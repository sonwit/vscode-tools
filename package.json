{
  "name": "vscode-tools",
  "displayName": "VSCode tools",
  "description": "Useful tools for VSCode to enhance your coding experience.",
  "version": "0.0.5",
  "publisher": "sonwit",
  "repository": {
    "type": "git",
    "url": "https://github.com/sonwit/vscode-tools.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:vscode-tools.insertLog",
    "onCommand:vscode-tools.duplicateSelection",
    "onCommand:vscode-tools.openAgentPanel",
    "onView:vscode-tools.agentDemoView",
    "onCommand:vscode-tools.gitStash",
    "onCommand:vscode-tools.gitStashList",
    "onCommand:vscode-tools.gitStashRefresh",
    "onView:vscode-tools.gitStashView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentDemo",
          "title": "Agent Demo",
          "icon": "media/agent-demo.svg"
        },
        {
          "id": "gitStash",
          "title": "Git Stash",
          "icon": "media/git-stash.svg"
        }
      ]
    },
    "views": {
      "agentDemo": [
        {
          "type": "webview",
          "id": "vscode-tools.agentDemoView",
          "name": "Agent Demo"
        }
      ],
      "gitStash": [
        {
          "type": "webview",
          "id": "vscode-tools.gitStashView",
          "name": "Git Stash"
        }
      ]
    },
    "commands": [
      {
        "command": "vscode-tools.insertLog",
        "title": "Insert Console Log"
      },
      {
        "command": "vscode-tools.duplicateSelection",
        "title": "Duplicate Selection or Line"
      },
      {
        "command": "vscode-tools.openAgentPanel",
        "title": "Open Agent Demo"
      },
      {
        "command": "vscode-tools.gitStash",
        "title": "Git Stash: Save Changes"
      },
      {
        "command": "vscode-tools.gitStashList",
        "title": "Git Stash: List & Manage"
      },
      {
        "command": "vscode-tools.gitStashRefresh",
        "title": "Git Stash: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vscode-tools.gitStashRefresh",
          "when": "view == vscode-tools.gitStashView",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vscode-tools.insertLog",
        "key": "ctrl+alt+l",
        "mac": "ctrl+option+l",
        "when": "editorHasSelection"
      },
      {
        "command": "vscode-tools.duplicateSelection",
        "key": "ctrl+alt+d",
        "mac": "ctrl+option+d",
        "when": "editorTextFocus"
      },
      {
        "command": "vscode-tools.openAgentPanel",
        "key": "ctrl+alt+shift+a",
        "mac": "ctrl+option+shift+a",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node ./dist/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.7",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.30",
    "mocha": "^10.4.0",
    "typescript": "^5.3.3"
  }
}
